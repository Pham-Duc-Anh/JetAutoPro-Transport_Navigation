<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="arena_maze_6x4">
    <!-- Cài đặt vật lý cơ bản -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Các plugin mặc định cần thiết của Gazebo Ignition/Sim -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"></plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"></plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"></plugin>

    <!-- Ánh sáng mặt trời -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Mặt đất -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>15 15</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>15 15</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tường rào ngoài 6x4 (X từ -3 đến 3, Y từ -2 đến 2) -->
    <model name="wall_right">
      <static>true</static>
      <pose>3 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>-3 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_top">
      <static>true</static>
      <pose>0 2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.1 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_bottom">
      <static>true</static>
      <pose>0 -2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.1 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bức tường bên trái, dài 3m, gắn từ trên (y=2) xuống -->
    <model name="inner_wall_left">
      <static>true</static>
      <pose>-1 0.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 3.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.0 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.4 1</ambient><diffuse>0.8 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bức tường bên phải, dài 3m, gắn từ dưới (y=-2) lên -->
    <model name="inner_wall_right">
      <static>true</static>
      <pose>1 -0.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 3.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.0 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.4 1</ambient><diffuse>0.8 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Thùng rác màu xanh ở ô góc trên bên trái -->
    <model name="recycle_bin">
      <static>true</static>
      <pose>-2.5 1.5 0 0 0 0</pose>
      <link name="link">
        <!-- Đáy thùng -->
        <collision name="base"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.4 0.4 0.01</size></box></geometry></collision>
        <visual name="base_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.4 0.4 0.01</size></box></geometry>
          <material><ambient>0.0 0.6 1.0 1</ambient><diffuse>0.0 0.6 1.0 1</diffuse></material></visual>
        <!-- Tường trước -->
        <collision name="wall_f"><pose>0.19 0 0.075 0 0 0</pose><geometry><box><size>0.02 0.4 0.15</size></box></geometry></collision>
        <visual name="wall_fv"><pose>0.19 0 0.075 0 0 0</pose><geometry><box><size>0.02 0.4 0.15</size></box></geometry>
          <material><ambient>0.0 0.6 1.0 1</ambient><diffuse>0.0 0.6 1.0 1</diffuse></material></visual>
        <!-- Tường sau -->
        <collision name="wall_b"><pose>-0.19 0 0.075 0 0 0</pose><geometry><box><size>0.02 0.4 0.15</size></box></geometry></collision>
        <visual name="wall_bv"><pose>-0.19 0 0.075 0 0 0</pose><geometry><box><size>0.02 0.4 0.15</size></box></geometry>
          <material><ambient>0.0 0.6 1.0 1</ambient><diffuse>0.0 0.6 1.0 1</diffuse></material></visual>
        <!-- Tường trái -->
        <collision name="wall_l"><pose>0 0.19 0.075 0 0 0</pose><geometry><box><size>0.4 0.02 0.15</size></box></geometry></collision>
        <visual name="wall_lv"><pose>0 0.19 0.075 0 0 0</pose><geometry><box><size>0.4 0.02 0.15</size></box></geometry>
          <material><ambient>0.0 0.6 1.0 1</ambient><diffuse>0.0 0.6 1.0 1</diffuse></material></visual>
        <!-- Tường phải -->
        <collision name="wall_r"><pose>0 -0.19 0.075 0 0 0</pose><geometry><box><size>0.4 0.02 0.15</size></box></geometry></collision>
        <visual name="wall_rv"><pose>0 -0.19 0.075 0 0 0</pose><geometry><box><size>0.4 0.02 0.15</size></box></geometry>
          <material><ambient>0.0 0.6 1.0 1</ambient><diffuse>0.0 0.6 1.0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Khối hộp nhỏ màu xanh để gắp -->
    <model name="blue_box">
      <static>false</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000013</ixx>
            <iyy>0.000013</iyy>
            <izz>0.000013</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.04 0.04 0.04</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.04 0.04 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.0 1.0 1</ambient>
            <diffuse>0.0 0.0 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
