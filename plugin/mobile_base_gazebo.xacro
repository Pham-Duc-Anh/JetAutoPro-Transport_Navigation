<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <gazebo>
        <!-- ============================================ -->
        <!-- Joint State Publisher for Ignition Gazebo     -->
        <!-- Publishes joint states for arm + gripper      -->
        <!-- ============================================ -->
        <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
                name="ignition::gazebo::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <update_rate>50</update_rate>
            <!-- Arm joints -->
            <joint_name>joint1</joint_name>
            <joint_name>joint2</joint_name>
            <joint_name>joint3</joint_name>
            <joint_name>joint4</joint_name>
            <joint_name>joint5</joint_name>
            <!-- Gripper joints -->
            <joint_name>r_joint</joint_name>
            <joint_name>l_joint</joint_name>
            <joint_name>r_in_joint</joint_name>
            <joint_name>r_out_joint</joint_name>
            <joint_name>l_in_joint</joint_name>
            <joint_name>l_out_joint</joint_name>
            <!-- Wheel joints -->
            <joint_name>wheel_right_front_joint</joint_name>
            <joint_name>wheel_left_front_joint</joint_name>
            <joint_name>wheel_right_back_joint</joint_name>
            <joint_name>wheel_left_back_joint</joint_name>
        </plugin>

        <!-- ============================================ -->
        <!-- Arm Position Controllers (joint1-5)           -->
        <!-- ============================================ -->
        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>joint1</joint_name>
            <p_gain>100</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>joint2</joint_name>
            <p_gain>100</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>joint3</joint_name>
            <p_gain>100</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>joint4</joint_name>
            <p_gain>100</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>joint5</joint_name>
            <p_gain>100</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <!-- ============================================ -->
        <!-- Gripper Position Controllers                  -->
        <!-- Ignition does NOT support <mimic> tags, so    -->
        <!-- each gripper joint needs its own controller   -->
        <!-- to hold position at 0 (closed).               -->
        <!-- ============================================ -->
        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>r_joint</joint_name>
            <p_gain>10</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>l_joint</joint_name>
            <p_gain>10</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>r_in_joint</joint_name>
            <p_gain>10</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>r_out_joint</joint_name>
            <p_gain>10</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>l_in_joint</joint_name>
            <p_gain>10</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>l_out_joint</joint_name>
            <p_gain>10</p_gain>
            <i_gain>0</i_gain>
            <d_gain>5</d_gain>
        </plugin>

        <!-- ============================================ -->
        <!-- Mecanum Wheel Drive Controller               -->
        <!-- ============================================ -->
        <plugin filename="libignition-gazebo-mecanum-drive-system.so"
                name="ignition::gazebo::systems::MecanumDrive">
            <front_left_joint>wheel_left_front_joint</front_left_joint>
            <front_right_joint>wheel_right_front_joint</front_right_joint>
            <back_left_joint>wheel_left_back_joint</back_left_joint>
            <back_right_joint>wheel_right_back_joint</back_right_joint>
            <wheel_separation>0.17225</wheel_separation>
            <wheelbase>0.194794</wheelbase>
            <wheel_radius>0.049</wheel_radius>
            <topic>/cmd_vel</topic>
        </plugin>

        <!-- ============================================ -->
        <!-- Odometry Publisher                           -->
        <!-- ============================================ -->
        <plugin filename="libignition-gazebo-odometry-publisher-system.so"
                name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <dimensions>3</dimensions>
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/odom_tf</tf_topic>
        </plugin>

    </gazebo>

    <!-- ================================================ -->
    <!-- Lidar Sensor (gpu_lidar on lidar_link)           -->
    <!-- ================================================ -->
    <!-- IMU Sensor Plugin                                -->
    <!-- ================================================ -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <visualize>true</visualize>
            <topic>imu</topic>
            <gz_frame_id>imu_link</gz_frame_id>
        </sensor>
    </gazebo>

    <!-- ================================================ -->
    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.000000</resolution>
                        <min_angle>-2.0944</min_angle>
                        <max_angle>2.0944</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.350000</min>
                    <max>12.0</max>
                    <resolution>0.015000</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
        </sensor>
    </gazebo>

    <!-- ================================================ -->
    <!-- Wheel friction settings (Ignition/SDF format)     -->
    <!-- Mecanum wheels - high mu along roller axis,       -->
    <!-- low mu2 perpendicular (roller slip direction)     -->
    <!-- ================================================ -->
    <!-- Right Front wheel - roller axis 45 deg (1, -1, 0) -->
    <gazebo reference="wheel_right_front_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.1</mu2>
                        <fdir1>1 -1 0</fdir1>
                    </ode>
                    <bullet>
                        <friction>1.0</friction>
                        <friction2>0.1</friction2>
                        <fdir1>1 -1 0</fdir1>
                    </bullet>
                </friction>
                <contact>
                    <ode>
                        <kp>10000000.0</kp>
                        <kd>1.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.0</max_vel>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>
    <!-- Left Front wheel - roller axis 45 deg (1, 1, 0) -->
    <gazebo reference="wheel_left_front_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.1</mu2>
                        <fdir1>1 1 0</fdir1>
                    </ode>
                    <bullet>
                        <friction>1.0</friction>
                        <friction2>0.1</friction2>
                        <fdir1>1 1 0</fdir1>
                    </bullet>
                </friction>
                <contact>
                    <ode>
                        <kp>10000000.0</kp>
                        <kd>1.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.0</max_vel>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>
    <!-- Right Back wheel - roller axis 45 deg (1, 1, 0) -->
    <gazebo reference="wheel_right_back_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.1</mu2>
                        <fdir1>1 1 0</fdir1>
                    </ode>
                    <bullet>
                        <friction>1.0</friction>
                        <friction2>0.1</friction2>
                        <fdir1>1 1 0</fdir1>
                    </bullet>
                </friction>
                <contact>
                    <ode>
                        <kp>10000000.0</kp>
                        <kd>1.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.0</max_vel>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>
    <!-- Left Back wheel - roller axis 45 deg (1, -1, 0) -->
    <gazebo reference="wheel_left_back_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.1</mu2>
                        <fdir1>1 -1 0</fdir1>
                    </ode>
                    <bullet>
                        <friction>1.0</friction>
                        <friction2>0.1</friction2>
                        <fdir1>1 -1 0</fdir1>
                    </bullet>
                </friction>
                <contact>
                    <ode>
                        <kp>10000000.0</kp>
                        <kd>1.0</kd>
                        <min_depth>0.001</min_depth>
                        <max_vel>0.0</max_vel>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

</robot>
