<launch>
    <!-- Khai báo đường dẫn urdf ra riêng để tiện debug -->
    <let name="urdf_path" value="$(find-pkg-share jetauto_simulation)/urdf/jetauto.xacro" />

    <set_env name="need_compile" value="True" />
    <set_env name="IGN_GAZEBO_RESOURCE_PATH" value="$(find-pkg-share jetauto_simulation)/.." />
    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share jetauto_simulation)/.." />

    <!-- Robot State Publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
        <param name="robot_description" 
               value="$(command 'env need_compile=True MACHINE_TYPE=JetAutoPro LIDAR_TYPE=A1 DEPTH_CAMERA_TYPE=AstraPro xacro $(var urdf_path)')" />
        <param name="use_sim_time" value="true" />
    </node>

    <!-- Joint State Publisher -->
    <node pkg="joint_state_publisher" exec="joint_state_publisher" name="joint_state_publisher" output="screen">
        <param name="robot_description" 
               value="$(command 'env need_compile=True MACHINE_TYPE=JetAutoPro LIDAR_TYPE=A1 DEPTH_CAMERA_TYPE=AstraPro xacro $(var urdf_path)')" />
        <param name="use_sim_time" value="true" />
        <param name="source_list" value="[/gz_joint_states]" />
        <param name="rate" value="50" />
    </node>

    <!-- Khởi chạy Gazebo Ignition với arena_maze_4x4 world -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r $(find-pkg-share jetauto_simulation)/worlds/arena_maze_6x4.sdf" />
    </include>

    <!-- Spawn robot -->
    <node pkg="ros_gz_sim" exec="create" name="spawn_entity" output="screen"
          args="-name jetauto -topic robot_description -x 2.0 -y -1.5 -z 0.05 -Y 1.5708" />

    <!-- Bridge ROS 2 và Gazebo Ignition -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="ros_gz_bridge" output="screen">
        <param name="config_file" value="$(find-pkg-share jetauto_simulation)/bridge_config/ros_gz_bridge.yaml" />
    </node>

    <!-- ================================================ -->
    <!-- EKF Node (Trộn Odom + IMU)                       -->
    <!-- ================================================ -->
    <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node">
        <param from="$(find-pkg-share jetauto_simulation)/params/ekf.yaml" />
        <remap from="odometry/filtered" to="odom_filtered"/>
    </node>

    <!-- ================================================ -->
    <!-- SLAM Toolbox (Quét bản đồ mới)                   -->
    <!-- Dùng teleop để lái xe đi quét, sau đó lưu map    -->
    <!-- ================================================ -->
    <node pkg="slam_toolbox" exec="async_slam_toolbox_node" name="slam_toolbox" output="screen">
        <param from="$(find-pkg-share jetauto_simulation)/params/slam_toolbox_params.yaml" />
    </node>

    <!-- Khởi chạy RViz -->
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
          args="-d $(find-pkg-share jetauto_simulation)/rviz_config/view.rviz">
        <param name="use_sim_time" value="true" />
    </node>

</launch>
